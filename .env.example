# PayPal sandbox REST app credentials: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_ENV=sandbox

# AI provider (any OpenAI-compatible API). Default: Google Gemini free tier.
# Free key (no card): https://aistudio.google.com/apikey
AI_API_KEY=your-gemini-api-key
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-flash-latest

# Public URL of this app (PayPal redirects buyers back here). Not needed on Render.
BASE_URL=http://localhost:3000
PORT=3000

# Guardrail: the agent may not create a single checkout above this amount
MAX_CHECKOUT_USD=5000
